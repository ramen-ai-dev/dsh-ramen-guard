{
  "name": "@ramen-ai/dsh-ramen-guard",
  "version": "0.2.0",
  "description": "Fail-closed ramen ai execution boundary for DeepSeek Harness tool calls, with a keyless trial and ramen foundry profiles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramen-ai-dev/dsh-ramen-guard.git"
  },
  "homepage": "https://ramenai.dev",
  "bugs": {
    "url": "https://github.com/ramen-ai-dev/dsh-ramen-guard/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ramen-foundry",
    "agent-governance",
    "keyless-trial"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@ramen-ai/node-core": "^0.3.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "24.0.0",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
